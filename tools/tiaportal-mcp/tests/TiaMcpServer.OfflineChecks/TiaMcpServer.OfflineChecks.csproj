<Project Sdk="Microsoft.NET.Sdk">
  <!--
    最小离线自检套件 —— 控制台 Exe，不是 VSTest 工程。

    为什么这么做：这里链接的是引擎的**源文件**，而引擎主体依赖 Siemens.Engineering.dll
    （要本机装了 TIA Portal 才编得动），托管 runner 上编不动整个工程。所以只把**零依赖**
    的那几个文件链进来，用 `dotnet run` 驱动 —— 这样 CI 里也能跑。

    ⚠️ 千万别用 `dotnet test` 跑它：控制台 Exe 上它只会还原、一个用例都不跑、然后退 0 ——
    一个和「全部通过」长得一模一样的假绿灯。CI 里写死的是 `dotnet run`。

    链接进来源的每个文件都必须**不引用 Siemens.Engineering**（见各自的 Siemens-free 注释）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TiaMcpServer.OfflineChecks</AssemblyName>
    <RootNamespace>TiaMcpServer.OfflineChecks</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 版本自路由：Siemens-free（注释即写明"safe to JIT before any Openness assembly resolves"）。
         盯的是 Windows 参数重引号 —— 它只在路径带空格/引号/尾随反斜杠时出错，静默且难查。 -->
    <Compile Include="..\..\src\TiaMcpServer\Siemens\EngineRouter.cs" Link="EngineRouter.cs" />
    <!-- SimaticML(FlgNet/StructuredText) 文本回读：Siemens-free（只依赖 System.Xml.Linq）。
         盯的是「回读出来的逻辑和工程里真实逻辑不一致」——错了不报错、不崩，只会让人看到不存在的逻辑。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\LadTextRenderer.cs" Link="LadTextRenderer.cs" />
    <!-- 大响应寄存的判定与切片：零依赖（只 System.* + Linq），专门抽成这样就是为了能在这里被喂真输入。
         它坏了不会崩 —— 只会让某一页报废、或让调用方在同一位置无限打转 —— 属于「坏了也悄无声息」那一类，
         只有会失败的用例盯得住（代理对切点、越界夹紧、以及三态错误 expired/evicted/unknown 的区分）。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\ExportStore.cs" Link="ExportStore.cs" />
    <!-- 仿真能力判定：零依赖（只 System.* + Linq）。这块最危险的失败不是崩，而是给出一个
         **看起来很确定的错误结论**（把"没查到"当"没有"、把 Advanced 当经典 PLCSIM）——
         正好本仓为此踩过两次坑，所以判定逻辑抽成零依赖文件，用真机数据当 fixture 盯住它。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\SimulationProbe.cs" Link="SimulationProbe.cs" />
    <!-- 参数诊断的判定逻辑：零依赖（不引 MCP 类型、不做 I/O）。它坏了不会崩 —— 只会让
         "参数写错"退回成一句零信息失败，或者反过来把本来能跑的调用拦下来；两种都是
         "看起来正常"的坏，只有会失败的用例盯得住。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\ArgDiagnostics.cs" Link="ArgDiagnostics.cs" />
    <!-- SimaticML Access / SCL 正文回读的判定（LadTextRenderer 已改用它）：只依赖 System.Xml.Linq。
         盯的是「函数调用被读成 #A.B」这类**静默回读造假** —— 编不出错、看不出假，只有会失败的用例盯得住。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\SimaticMlText.cs" Link="SimaticMlText.cs" />
    <!-- HMI 画面树的递归遍历（含嵌套画面组）：纯反射、零依赖。原来只读根级 Screens，组里的画面会「查不到」。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\HmiScreenWalk.cs" Link="HmiScreenWalk.cs" />
    <!-- .s7res（是 YAML 不是 XML）缺 en-US 的扫描：零依赖。旧实现用 XDocument.Load 必抛、预检从未报过警。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\S7ResScanner.cs" Link="S7ResScanner.cs" />
    <!-- 判断「本次调用失败」还是「TIA 进程已死」：零依赖（按类型名判断，不硬引用 Openness 异常类型）。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\PortalFailureClassifier.cs" Link="PortalFailureClassifier.cs" />
    <!-- 语义打分词表（中性默认 + 环境变量可扩展行业术语）：零依赖。"默认不含行业词"这条通用化边界靠用例钉住。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\SemanticLexicon.cs" Link="SemanticLexicon.cs" />
  </ItemGroup>
</Project>
